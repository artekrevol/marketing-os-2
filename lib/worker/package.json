{
  "name": "@workspace/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "default": "./dist/embedded.mjs"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:enqueue-heartbeat": "tsx src/test/enqueue-heartbeat.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sentry/node": "^8.55.0",
    "@workspace/content-ai": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-dataforseo": "workspace:*",
    "@workspace/integrations-originality-ai": "workspace:*",
    "@workspace/jobs": "workspace:*",
    "@workspace/quality-gate": "workspace:*",
    "@workspace/services-recovery": "workspace:*",
    "bullmq": "^5.40.0",
    "drizzle-orm": "catalog:",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "thread-stream": "3.1.0",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "tsx": "catalog:",
    "vitest": "^2.1.9"
  }
}
