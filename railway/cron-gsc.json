{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @workspace/worker run build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production pnpm --filter @workspace/worker run scheduled:dispatch -- gsc",
    "cronSchedule": "0 4 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 2
  }
}
